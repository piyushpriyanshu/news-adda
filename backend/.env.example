# Copy to .env (never commit .env). All values are optional.
NEWSADDA_DB=var/newsadda.db
# Seconds between scheduler ticks; each source still respects its own min_interval.
NEWSADDA_POLL_TICK=60
# Official X API v2 bearer token (recent search). Without it X posts are skipped.
X_BEARER_TOKEN=
# Optional Hindi rewrites of English publisher descriptions.
NEWSADDA_AI_SUMMARY=0
ANTHROPIC_API_KEY=
# Protects POST /api/v1/refresh
NEWSADDA_ADMIN_TOKEN=
